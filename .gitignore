# ── Date de producţie şi secrete — NU intră niciodată în git ─────────────────
# baza managerului (clienţi, comenzi, utilizatori, sesiuni) + backup-urile ei
manager/date/
# orice copie a bazei (ex. manager.sqlite scos pt. server) — conţine clienţii
*.sqlite
*.sqlite-wal
*.sqlite-shm
# certificate TLS / chei
manager/certs/
*.pem
*.key
*.p12
*.pfx
# Materialele de lucru, ţinute doar pe laptop (curăţenia din 2026-10-19):
#   materiale/    — sursele de la firmă (Excel-uri, formulare, PDF-uri, documentaţia ERP + parola din ea)
#   date-clienti/ — exporturi şi rapoarte cu date de clienţi (FAN, TP, adrese-de-completat.csv …)
#   arhiva/       — ce e vechi (backup-uri, capturi, demo-ul vechi de pe Cloudflare, prototipuri)
/materiale/
/date-clienti/
/arhiva/
# variabile de mediu (MANAGER_*, chei API)
.env
.env.*
.dev.vars
# conectorul ERP (exemplul furnizorului; fişierul de parametri va ţine parola)
/TestWebConnector*.php

# ── Generate — se refac la build ────────────────────────────────────────────
node_modules
configurator_usi/dist/
configurator_usi/dist_pages/

# ── Varianta statică pt. Cloudflare Pages — doar un test, rămâne local ──────
configurator_usi/build_pages.js
configurator_usi/pages/
# cataloagele binare se reconstruiesc din *.seed.sql (sursa, care intră în git)
configurator_usi/js/catalog/*.sqlite

# ── Documente de lucru şi fişiere ale firmei (rămân doar local) ─────────────
*.xlsx
*.xlsm
*.xls
*.doc
*.docx
/Screenshot_*.png
/schita*.png
/schite/
/schite rame/
*.tar.gz
# PDF-uri exportate pt. tipar / şef (sursa e documentul din Claude Docs)
*.pdf

# ── Prototipuri vechi, înlocuite de manager/web/scan (păstrate doar local) ──
/scanare/
/test_scanare/

# ── Unelte / editor / sistem ────────────────────────────────────────────────
.idea/
.vscode/
.claude/
.wrangler/
graphify-out/
.graphifyignore
.directory
.DS_Store
*.log
# Superdesign — schiţele de interfaţă, unealtă de lucru, nu parte din aplicaţie
.superdesign/

# ── Demo static pe Cloudflare (manager + configurator în browser) — doar local ──
/demo_cloudflare/

# baza de clienţi a firmei (date personale) — importată pe Cloudflare cu clienti-agenti/importa.mjs, NU intră în git
/Livrare_MASINA*.xlsx
# fişierul de test al cititorului de Excel are doar date inventate
!clienti-agenti/test/test-clienti.xlsx
pachet/
