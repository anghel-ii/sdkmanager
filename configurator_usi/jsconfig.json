// Verificare de tipuri pe motorul de calcul (js/lib), fără conversie la TypeScript:
// prinde proprietăţi scrise greşit, importuri inexistente, argumente lipsă.
// Rulează cu `npm run tipuri`; editorul o arată şi el, subliniat.
{
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": ["js/lib"]
}
